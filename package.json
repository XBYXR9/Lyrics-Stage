{
  "name": "spotify-lyrics-stage",
  "private": true,
  "version": "0.8.1",
  "type": "module",
  "description": "Apple Music-style animated lyrics for Spotify — a desktop app that follows the Spotify app (Automix included), plus a web version.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "app:dev": "node scripts/dev-app.mjs",
    "app:build": "npm run typecheck && vite build && node scripts/build-electron.mjs && electron-builder --publish never",
    "app:start": "vite build && node scripts/build-electron.mjs && electron .",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p electron",
    "test": "vitest run",
    "android:sync": "vite build && cap sync android"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dbus-next": "^0.10.2",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "yaml": "^2.9.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xbyxr9/spotifylyrics.git"
  },
  "overrides": {
    "xml2js": "^0.6.2"
  },
  "main": "dist-electron/main.cjs",
  "author": "Lyrics Stage contributors",
  "homepage": "https://github.com/xbyxr9/spotifylyrics",
  "build": {
    "appId": "io.github.xbyxr9.lyricsstage",
    "productName": "Lyrics Stage",
    "artifactName": "Lyrics-Stage-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "XBYXR9",
        "repo": "Lyrics-Stage"
      }
    ],
    "electronUpdaterCompatibility": ">=2.16",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "!**/*.map",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Lyrics Stage reads what's playing in Spotify and controls playback so it can show synced lyrics."
      }
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "maintainer": "Lyrics Stage contributors"
    }
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/share": "^8.0.3"
  }
}
